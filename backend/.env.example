# CompliGate Backend Configuration

# Policy settings
POLICY_VERSION=RLUSD_US_v1
JURISDICTION=US
CURRENCY=RLUSD
ISSUER_ADDRESS=rEXAMPLE_ISSUER_ADDRESS

# Optional: Base64-encoded Ed25519 seed (32 bytes).
# If blank, an ephemeral key is generated on each run (MVP mode).
COMPLIGATE_PRIVATE_KEY_B64=

# Comma-separated allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# API key auth settings
# Set to false to disable API key auth in local development.
API_KEY_ENABLED=true
# Header checked for API key value.
API_KEY_HEADER_NAME=X-API-Key
# Comma-separated valid API keys.
API_KEYS=
# Legacy key list variable (fallback only).
AUTH_API_KEYS=

# PostgreSQL connection string for persistence (recommended in production).
# Example: postgresql+psycopg://compligate:password@localhost:5432/compligate
DATABASE_URL=

# --- XRPL Settings ---

# XRPL JSON-RPC endpoint (e.g. https://s.altnet.rippletest.net:51234)
XRPL_RPC_URL=

# XRPL network identifier used in metadata (e.g. xrpl_testnet | mainnet | devnet)
XRPL_NETWORK=xrpl_testnet

# Seed for the demo XRPL wallet (testnet only – never commit a mainnet seed)
XRPL_DEMO_WALLET_SEED=

# Signing seed used for /v1/xrpl/payment in production.
XRPL_SIGNING_SEED=

# RLUSD issuer address on XRPL (leave blank to skip issuer validation)
RLUSD_ISSUER=

# RLUSD currency code (default: RLUSD)
RLUSD_CURRENCY=RLUSD

# Require trustline for RLUSD before settlement (default: true)
XRPL_REQUIRE_TRUSTLINE=true

# Enforce RLUSD-only payments (default: false)
XRPL_ENFORCE_RLUSD_ONLY=false

# Permit time-to-live in seconds (default: 300)
PERMIT_TTL_SECONDS=300

# Max in-memory recent permit contexts retained (default: 1000)
PERMIT_CONTEXT_CACHE_MAX_ITEMS=1000
