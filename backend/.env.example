# CompliGate Backend Configuration

# Policy settings
POLICY_VERSION=RLUSD_US_v1
JURISDICTION=US
CURRENCY=RLUSD
ISSUER_ADDRESS=rEXAMPLE_ISSUER_ADDRESS

# Optional: Base64-encoded Ed25519 seed (32 bytes).
# If blank, an ephemeral key is generated on each run (MVP mode).
COMPLIGATE_PRIVATE_KEY_B64=

# Comma-separated allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# API key auth settings
# Set to false to disable API key auth in local development.
API_KEY_ENABLED=true
# Header checked for API key value.
API_KEY_HEADER_NAME=X-API-Key
# Comma-separated valid API keys.
API_KEYS=
# Legacy key list variable (fallback only).
AUTH_API_KEYS=

# PostgreSQL connection string for persistence (recommended in production).
# Example: postgresql+psycopg://compligate:password@localhost:5432/compligate
DATABASE_URL=

# --- XRPL Settings ---

# XRPL JSON-RPC endpoint. Default points at the public XRPL testnet so the
# backend can reach a real network out of the box.
XRPL_RPC_URL=https://s.altnet.rippletest.net:51234

# XRPL network identifier used in metadata (e.g. testnet | mainnet | devnet).
XRPL_NETWORK=testnet

# Seed for the demo XRPL wallet (testnet only – never commit a mainnet seed)
XRPL_DEMO_WALLET_SEED=

# --- XRPL signing ---
# Signing mode used by /v1/xrpl/payment. Supported values:
#   seed     - local seed-based signing (dev / staging only)
#   disabled - signing is turned off; payment endpoint returns a structured error
#   external - placeholder for a future HSM / custody signer integration (not implemented yet)
XRPL_SIGNING_MODE=seed

# Master kill switch for XRPL signing. When false the payment endpoint
# returns a structured error regardless of XRPL_SIGNING_MODE.
XRPL_SIGNING_ENABLED=true

# Expected XRPL classic address of the configured signer. Optional – when set,
# the seed must derive to this address or signing is refused.
XRPL_SIGNER_ADDRESS=

# Seed used by the "seed" signing mode. Preferred over the legacy
# XRPL_SIGNING_SEED variable below when both are set.
XRPL_SIGNER_SEED=

# Legacy signing seed kept for backward compatibility. Used as a fallback
# when XRPL_SIGNER_SEED is not configured.
XRPL_SIGNING_SEED=

# RLUSD issuer address on XRPL (leave blank to skip issuer validation)
RLUSD_ISSUER=

# RLUSD currency code (default: RLUSD)
RLUSD_CURRENCY=RLUSD

# Require trustline for RLUSD before settlement.
# Recommended: false on testnet (so demo flows work without setting up trustlines),
# true on mainnet.
XRPL_REQUIRE_TRUSTLINE=false

# Enforce RLUSD-only payments (default: false)
XRPL_ENFORCE_RLUSD_ONLY=false

# Permit time-to-live in seconds (default: 300)
PERMIT_TTL_SECONDS=300

# Max in-memory recent permit contexts retained (default: 1000)
PERMIT_CONTEXT_CACHE_MAX_ITEMS=1000

# --- Compliance providers ---
# When no concrete sanctions / KYC / reserve providers are wired up, the
# abstraction layer fails closed (decision = DENY) by default. Set this to
# true ONLY for local development to allow the unconfigured providers to
# return an explicit ALLOW / SKIPPED result. Never enable in production.
ALLOW_UNCONFIGURED_PROVIDERS=false
# CompliGate delegates each compliance check to a configured provider and
# fails closed when no real provider is configured. Supported kinds:
#   null           - no provider; engine denies with *_PROVIDER_UNAVAILABLE (default)
#   static_allow   - explicit, traceable approval for local dev / tests only
#   http           - real third-party HTTPS endpoint (URL + API key required)
#   address_screen - sanctions only: real address-screening vendor that screens
#                    the transaction subject and (when present) the destination
#                    wallet via app/services/providers/HttpSanctionsProvider.
#                    Requires SANCTIONS_PROVIDER_URL and SANCTIONS_API_KEY.
#
# API keys can be supplied via the short *_API_KEY form (preferred for
# real-provider integrations) or the historical *_PROVIDER_API_KEY form,
# which is kept for backward compatibility.

# KYC provider
# Supported KYC kinds:
#   null               - no provider; fail closed (default)
#   static_allow       - explicit, traceable approval for local dev / tests
#   http               - direct integration with a real third-party KYC API
#                        (set KYC_PROVIDER_URL and KYC_API_KEY)
#   upstream_assertion - trust an HMAC-signed KYC assertion supplied by an
#                        upstream institutional system. Requires
#                        KYC_UPSTREAM_ASSERTION_SECRET and
#                        KYC_UPSTREAM_ASSERTION_TRUSTED_ISSUERS to be set,
#                        and the permit request must include a
#                        ``kyc_assertion`` payload.
KYC_PROVIDER=null
KYC_PROVIDER_URL=
KYC_API_KEY=
KYC_PROVIDER_API_KEY=
# Shared secret used to verify HMAC-SHA256 signatures on trusted upstream
# KYC assertions. Required when KYC_PROVIDER=upstream_assertion.
KYC_UPSTREAM_ASSERTION_SECRET=
# Comma-separated allowlist of trusted upstream KYC issuer identifiers.
# Required when KYC_PROVIDER=upstream_assertion. Assertions signed by an
# issuer not present in this list are rejected.
KYC_UPSTREAM_ASSERTION_TRUSTED_ISSUERS=

# Sanctions screening provider
SANCTIONS_PROVIDER=null
SANCTIONS_PROVIDER_URL=
SANCTIONS_API_KEY=
SANCTIONS_PROVIDER_API_KEY=

# Reserve / 1:1 backing attestation provider
# Supported reserve kinds:
#   null          - no provider; fail closed (default)
#   static_allow  - explicit, traceable approval for local dev / tests
#   http          - direct integration with a real reserve / proof-of-
#                   reserves API (set RESERVE_PROVIDER_URL and
#                   RESERVE_API_KEY). The response is expected to
#                   carry explicit ``reserve_status`` and
#                   ``liquidity_status`` fields ('verified' /
#                   'not_verified' / 'unavailable').
#   attestation   - trust an HMAC-signed reserve / liquidity
#                   attestation supplied by an upstream custodian,
#                   independent auditor, or the issuer itself.
#                   Requires RESERVE_ATTESTATION_SECRET and
#                   RESERVE_ATTESTATION_TRUSTED_ATTESTORS to be set,
#                   and the permit request must include a
#                   ``reserve_attestation`` payload.
RESERVE_PROVIDER=null
RESERVE_PROVIDER_URL=
RESERVE_API_KEY=
RESERVE_PROVIDER_API_KEY=
# Shared secret used to verify HMAC-SHA256 signatures on trusted
# reserve / liquidity attestations. Required when
# RESERVE_PROVIDER=attestation.
RESERVE_ATTESTATION_SECRET=
# Comma-separated allowlist of trusted attestor identifiers (custodians,
# auditors, issuers). Required when RESERVE_PROVIDER=attestation.
# Attestations signed by an attestor not present in this list are
# rejected.
RESERVE_ATTESTATION_TRUSTED_ATTESTORS=

# When true (default), the compliance engine denies rather than silently
# passing when a provider is missing or unavailable. Only set to false
# for narrow local-development scenarios; never in production.
FAIL_CLOSED_COMPLIANCE=true
