# CompliGate Backend Configuration

# Policy settings
POLICY_VERSION=RLUSD_US_v1
JURISDICTION=US

# Optional: Base64-encoded Ed25519 seed (32 bytes).
# If blank, an ephemeral key is generated on each run (MVP mode).
COMPLIGATE_PRIVATE_KEY_B64=

# Comma-separated allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- XRPL Settings ---

# XRPL JSON-RPC endpoint (e.g. https://s.altnet.rippletest.net:51234)
XRPL_RPC_URL=

# XRPL network identifier (testnet | mainnet | devnet)
XRPL_NETWORK=testnet

# Seed for the demo XRPL wallet (testnet only – never commit a mainnet seed)
XRPL_DEMO_WALLET_SEED=

# RLUSD issuer address on XRPL (leave blank to skip issuer validation)
RLUSD_ISSUER=

# RLUSD currency code (default: RLUSD)
RLUSD_CURRENCY=RLUSD

# Require trustline for RLUSD before settlement (default: true)
XRPL_REQUIRE_TRUSTLINE=true

# Enforce RLUSD-only payments (default: false)
XRPL_ENFORCE_RLUSD_ONLY=false

# Require RLUSD trustline before accepting payments (default: false)
XRPL_REQUIRE_TRUSTLINE=false

# Permit time-to-live in seconds (default: 300)
PERMIT_TTL_SECONDS=300
