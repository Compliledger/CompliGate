# ============================================================
# CompliGate — Railway Environment Variables
# ============================================================
# Copy the values below into Railway → Variables tab, or run
# them in bulk using the Railway CLI:
#
#   railway variables set KEY=VALUE KEY2=VALUE2
#
# Variables marked [REQUIRED] must be set before first deploy.
# Variables marked [DEFAULT OK] ship with a safe default.
# Variables marked [SECRET] must never be committed to git.
# ============================================================


# ---- Core API -----------------------------------------------

# [REQUIRED] [SECRET]
# Stable base64-encoded Ed25519 signing seed for permit bundles.
# Generate with: python3 -c "import nacl.signing,base64; print(base64.b64encode(nacl.signing.SigningKey.generate()._signing_key[:32]).decode())"
COMPLIGATE_PRIVATE_KEY_B64=

# [REQUIRED] [SECRET]
# Comma-separated list of API keys that protect the backend.
API_KEYS=

# [DEFAULT OK]
API_KEY_ENABLED=true

# [DEFAULT OK]
API_KEY_HEADER_NAME=X-API-Key

# [DEFAULT OK]
POLICY_VERSION=RLUSD_US_v1

# [DEFAULT OK]
JURISDICTION=US

# [DEFAULT OK]
CURRENCY=RLUSD

# [REQUIRED] — set to your actual RLUSD issuer address on testnet/mainnet
ISSUER_ADDRESS=


# ---- Database -----------------------------------------------

# [REQUIRED] [SECRET]
# Railway Postgres plugin injects this automatically if you attach
# a Postgres service. Otherwise paste your connection string here.
DATABASE_URL=


# ---- XRPL Network -------------------------------------------

# [DEFAULT OK] — testnet. Change to mainnet RPC when you go live.
XRPL_RPC_URL=https://s.altnet.rippletest.net:51234

# [DEFAULT OK]
XRPL_NETWORK=xrpl_testnet

# [REQUIRED] — the RLUSD token issuer on the configured network
RLUSD_ISSUER=

# [DEFAULT OK]
RLUSD_CURRENCY=RLUSD

# [DEFAULT OK] — set true to reject any non-RLUSD payments
XRPL_ENFORCE_RLUSD_ONLY=false

# [DEFAULT OK] — set true to require trustline check before permits
XRPL_REQUIRE_TRUSTLINE=false


# ---- XRPL Signing -------------------------------------------

# [DEFAULT OK for auth-only deploys]
# Options: seed | disabled | external
# Use "disabled" for authorization-only deployments (recommended first).
# Use "seed" only for staging/testnet demo signing.
# Never use "seed" with a mainnet wallet seed.
XRPL_SIGNING_MODE=disabled

# [DEFAULT OK]
XRPL_SIGNING_ENABLED=false

# [SECRET] — only needed when XRPL_SIGNING_MODE=seed
XRPL_SIGNING_SEED=

# [SECRET] — only needed when XRPL_SIGNING_MODE=seed
XRPL_SIGNER_SEED=

# — must match the seed above when signing is enabled
XRPL_SIGNER_ADDRESS=


# ---- Permit Lifecycle ---------------------------------------

# [DEFAULT OK] — permit time-to-live in seconds
PERMIT_TTL_SECONDS=300

# [DEFAULT OK]
PERMIT_CONTEXT_CACHE_MAX_ITEMS=1000


# ---- Compliance Providers -----------------------------------

# Options: null | static_allow | http
# "null" = fail-closed (denies everything) — safe default for demo
# "static_allow" = passes everyone — never use in production
# "http" = real provider integration

# [DEFAULT OK for demo]
KYC_PROVIDER=null
KYC_PROVIDER_URL=
KYC_API_KEY=

# [DEFAULT OK for demo]
SANCTIONS_PROVIDER=null
SANCTIONS_PROVIDER_URL=
SANCTIONS_API_KEY=

# [DEFAULT OK for demo]
RESERVE_PROVIDER=null
RESERVE_PROVIDER_URL=
RESERVE_API_KEY=

# [DEFAULT OK] — fail-closed if providers are unavailable
FAIL_CLOSED_COMPLIANCE=true


# ---- KYC Upstream Assertion (optional) ----------------------

# [SECRET] — used to validate HMAC-signed upstream KYC assertions
KYC_UPSTREAM_ASSERTION_SECRET=

# Comma-separated trusted issuer identifiers for upstream KYC
KYC_UPSTREAM_ASSERTION_TRUSTED_ISSUERS=


# ---- Reserve Upstream Attestation (optional) ----------------

# [SECRET]
RESERVE_ATTESTATION_SECRET=

# Comma-separated trusted attestor identifiers
RESERVE_ATTESTATION_TRUSTED_ATTESTORS=


# ---- CORS ---------------------------------------------------

# [REQUIRED] — set to your deployed frontend URL
# Example: https://compligate.netlify.app
CORS_ORIGINS=https://your-frontend-domain.com


# ============================================================
# Minimum viable Railway deploy (auth-only, testnet, demo):
# ============================================================
# COMPLIGATE_PRIVATE_KEY_B64=<generated>
# API_KEYS=<your-key>
# API_KEY_ENABLED=true
# DATABASE_URL=<railway-postgres-url>
# XRPL_RPC_URL=https://s.altnet.rippletest.net:51234
# XRPL_NETWORK=xrpl_testnet
# XRPL_SIGNING_MODE=disabled
# XRPL_SIGNING_ENABLED=false
# FAIL_CLOSED_COMPLIANCE=true
# CORS_ORIGINS=https://your-frontend-domain.com
# ============================================================
