# Base URL of the CompliGate backend API used by the frontend.
VITE_API_BASE=http://localhost:8000

# Optional. Build-time default API key sent as the X-API-Key header to the
# CompliGate backend. The user can override this at runtime via the
# "Set API Key" panel (stored in browser localStorage). Leave blank for
# user-supplied keys only. Do not commit real secrets.
VITE_API_KEY=
