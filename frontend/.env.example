# Base URL of the CompliGate backend API used by the frontend.
VITE_API_BASE=http://localhost:8000

# Optional. Build-time default API key sent to the CompliGate backend in the
# header named by VITE_API_KEY_HEADER (default `X-API-Key`). The user can
# override this at runtime via the "Set API Key" panel (stored in browser
# localStorage). Leave blank for user-supplied keys only. Do not commit real
# secrets.
VITE_API_KEY=

# Optional. Name of the HTTP header used to send the API key. Must match the
# backend's `API_KEY_HEADER_NAME` setting. Defaults to `X-API-Key`.
VITE_API_KEY_HEADER=X-API-Key
