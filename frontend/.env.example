# Base URL of the CompliGate backend API used by the frontend.
VITE_API_BASE=http://localhost:8000

# Optional. Build-time default API key sent to the CompliGate backend in the
# header named by VITE_API_KEY_HEADER (default `X-API-Key`). The user can
# override this at runtime via the "Set API Key" panel (stored in browser
# localStorage). Leave blank for user-supplied keys only. Do not commit real
# secrets.
VITE_API_KEY=

# Optional. Name of the HTTP header used to send the API key. Must match the
# backend's `API_KEY_HEADER_NAME` setting. Defaults to `X-API-Key`.
VITE_API_KEY_HEADER=X-API-Key

# Optional. Base URL of an XRPL transaction explorer used to deep-link the
# `tx_hash` returned by the backend (e.g. after submitting an XRPL payment).
# The frontend appends `/<tx_hash>` to this base URL, so set it to whatever
# your explorer expects up to (but not including) the transaction id.
#
# Leave blank to render `tx_hash` as plain text only — no explorer link is
# shown. Intentionally has no default: a public mainnet explorer is NOT
# hardcoded here, since transactions submitted from a testnet/devnet
# deployment would otherwise resolve to the wrong network.
#
# Examples (operator-supplied; pick the one matching your XRPL network):
#   VITE_XRPL_EXPLORER_BASE_URL=https://testnet.xrpl.org/transactions
#   VITE_XRPL_EXPLORER_BASE_URL=https://devnet.xrpl.org/transactions
VITE_XRPL_EXPLORER_BASE_URL=
